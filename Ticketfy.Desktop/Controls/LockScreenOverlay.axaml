<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Controls.LockScreenOverlay"
             x:DataType="vm:MainWindowViewModel">

    <!-- OVERLAY LOCK SCREEN (Prevents Modal Collision) -->
    <Grid ZIndex="9999" IsVisible="{Binding IsLocked}" Background="#E60F172A">
        <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="30" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <mi:MaterialIcon Kind="LockAlert" Width="26" Height="26" Foreground="{DynamicResource AccentDangerBrush}" />
                    <TextBlock Text="TERMINAL BLOQUEADA" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                
                <TextBlock Text="Use su contraseña. El PIN requiere una verificación primaria en los últimos 15 minutos de esta ejecución." TextWrapping="Wrap" MaxWidth="310" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                <CheckBox Content="Usar contraseña" IsChecked="{Binding LockScreen.UsePassword}" />
                
                <TextBox Text="{Binding UnlockPin, Mode=TwoWay}" PasswordChar="•" MaxLength="1024" Width="220" Padding="12" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" />
                
                <TextBlock Text="{Binding UnlockErrorMessage}" Foreground="{DynamicResource AccentDangerBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="310" IsVisible="{Binding UnlockErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                
                <Button Command="{Binding UnlockTerminalCommand}" Classes="danger-action" Width="220" Height="40" HorizontalAlignment="Center" CornerRadius="{DynamicResource AppCornerRadius}">
                    <TextBlock Text="DESBLOQUEAR" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Content="Cerrar sesión" Command="{Binding EndLockedSessionCommand}" HorizontalAlignment="Center" />
                <TextBlock Text="Cerrar sesión no cierra el turno ni cancela cobros pendientes." FontSize="11" TextWrapping="Wrap" MaxWidth="300" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
