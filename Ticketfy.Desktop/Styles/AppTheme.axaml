<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="using:Ticketfy.Core.Helpers">

    <Style Selector="TextBox, NumericUpDown, ComboBox, AutoCompleteBox">
        <Setter Property="DataValidationErrors.ErrorConverter" Value="{x:Static helpers:UserFacingErrors.ValidationConverter}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="CheckBox /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TICKETFY POS — NEXT.JS AESTHETIC DESIGN TOKEN SYSTEM
         Protocol VALCORE v4.0 — Dynamic Theme Token System
         Valcore Native CaptionButtons & High-Contrast Icons Standard
         (Eliminates 4-Box Artifacts & Restores Standard Window Controls)
         ═══════════════════════════════════════════════════════════ -->

    <Style Selector=":root">
        <Style.Resources>
            <!-- Dimensions -->
            <x:Double x:Key="SidebarWidth">80</x:Double>
            <x:Double x:Key="TopBarHeight">64</x:Double>
            <CornerRadius x:Key="RadiusSm">4</CornerRadius>
            <CornerRadius x:Key="RadiusMd">8</CornerRadius>
            <CornerRadius x:Key="RadiusLg">12</CornerRadius>
        </Style.Resources>
    </Style>

    <!-- ─── GLOBAL BODY & TYPOGRAPHY ─── -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BgPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppBaseFontSize}" />
    </Style>

    <Style Selector="UserControl">
        <Setter Property="Background" Value="{DynamicResource BgPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppBaseFontSize}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppBaseFontSize}" />
    </Style>

    <!-- ─── WINDOW TITLE BAR CAPTION BUTTONS (MINIMIZE, MAXIMIZE, CLOSE) ─── -->
    <Style Selector="CaptionButtons">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="CaptionButtons Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="MinWidth" Value="46" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style Selector="CaptionButtons Button:pointerover">
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <Style Selector="CaptionButtons Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="CaptionButtons Button#PART_CloseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#EF4444" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="CaptionButtons Button Path">
        <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="CaptionButtons Button PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="CaptionButtons Button:pointerover Path">
        <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="CaptionButtons Button:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="CaptionButtons Button#PART_CloseButton:pointerover Path">
        <Setter Property="Fill" Value="White" />
        <Setter Property="Stroke" Value="White" />
    </Style>

    <Style Selector="CaptionButtons Button#PART_CloseButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ─── UNIVERSAL MANDATORY INPUT FIELD BORDERS (1.5PX ALWAYS VISIBLE IN ALL STATES) ─── -->

    <!-- 1. TEXTBOX -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppBaseFontSize}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>

    <Style Selector="TextBox:not(:focus):not(:pointerover) /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
    </Style>

    <Style Selector="TextBox:pointerover:not(:focus) /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    </Style>

    <Style Selector="TextBox:focus:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    </Style>

    <!-- 2. COMBOBOX -->
    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppBaseFontSize}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    </Style>

    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>

    <Style Selector="ComboBox:not(:focus):not(:pointerover) /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
    </Style>

    <Style Selector="ComboBox:pointerover:not(:focus) /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- 3. CALENDARDATEPICKER -->
    <Style Selector="CalendarDatePicker">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppBaseFontSize}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="CalendarDatePicker /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>

    <Style Selector="CalendarDatePicker:not(:focus):not(:pointerover) /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    </Style>

    <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    </Style>

    <Style Selector="CalendarDatePicker:not(:focus):not(:pointerover) /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    </Style>

    <Style Selector="CalendarDatePicker:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
    </Style>

    <Style Selector="CalendarDatePicker:pointerover:not(:focus) /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
    </Style>

    <Style Selector="CalendarDatePicker:pointerover /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- 4. DATEPICKER -->
    <Style Selector="DatePicker">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppBaseFontSize}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="DatePicker /template/ Button#PART_FlyoutButton">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>

    <Style Selector="DatePicker:not(:focus):not(:pointerover) /template/ Button#PART_FlyoutButton">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    </Style>

    <Style Selector="DatePicker:pointerover /template/ Button#PART_FlyoutButton">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
    </Style>

    <Style Selector="DatePicker:pointerover:not(:focus) /template/ Button#PART_FlyoutButton">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
    </Style>

    <!-- 5. NUMERICUPDOWN & BUTTONSPINNER SPINNER ARROWS -->
    <Style Selector="NumericUpDown">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppBaseFontSize}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ButtonSpinner /template/ RepeatButton">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="ButtonSpinner /template/ RepeatButton PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="ButtonSpinner /template/ RepeatButton Path">
        <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover Path">
        <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton Path">
        <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:pointerover Path">
        <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 6. AUTOCOMPLETEBOX -->
    <Style Selector="AutoCompleteBox">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppBaseFontSize}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="AutoCompleteBox /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    </Style>

    <Style Selector="AutoCompleteBox:not(:focus):not(:pointerover) /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    </Style>

    <Style Selector="AutoCompleteBox:pointerover /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="AutoCompleteBox:pointerover:not(:focus) /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- ─── CLEAN CARDS WITH DYNAMIC CORNER RADIUS & ACCENT HOVER STROKE ─── -->
    <Style Selector="Border.clean-card">
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="Effect">
            <BlurEffect Radius="{DynamicResource GlassmorphismBlurRadius}" />
        </Setter>
    </Style>

    <Style Selector="Border.clean-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="Border.clean-card-sm">
        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
    </Style>

    <Style Selector="Border.clean-card-sm:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- ─── ANIMATED BUTTONS WITH VALCORE CONTRAST HOVER ─── -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
        <Setter Property="FontSize" Value="{DynamicResource AppBaseFontSize}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource TransitionDuration}">
                    <TransformOperationsTransition.Easing>
                        <CubicEaseOut />
                    </TransformOperationsTransition.Easing>
                </TransformOperationsTransition>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.primary-action">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.primary-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.success-action">
        <Setter Property="Background" Value="{DynamicResource AccentSuccessBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.success-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSuccessBrush}" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ─── NAVIGATION BUTTONS ─── -->
    <Style Selector="Button.nav-item">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarNavIconBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.nav-item-active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <!-- ─── CUSTOM WINDOW ACTION BUTTONS (TITLE BAR HIGH CONTRAST) ─── -->
    <Style Selector="Button.window-action-btn">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.window-action-btn:pointerover">
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <Style Selector="Button.window-action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.window-action-btn-close">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.window-action-btn-close:pointerover">
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <Style Selector="Button.window-action-btn-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#EF4444" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
    </Style>

</Styles>
