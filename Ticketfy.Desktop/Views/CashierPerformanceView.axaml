<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ticketfy.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Ticketfy.Views.CashierPerformanceView"
             x:DataType="vm:CashierPerformanceViewModel"
             Background="#0F172A">

    <Grid RowDefinitions="Auto,*">
        <!-- Header Controls -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,16" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                    <materialIcons:MaterialIcon Kind="AccountClock" Width="28" Height="28" Foreground="#10B981"/>
                    <TextBlock Text="Rendimiento y Productividad de Cajeros" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock Text="Periodo:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding StartDate}"/>
                    <TextBlock Text="a" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding EndDate}"/>
                    <TextBlock Text="Comisión %:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <NumericUpDown Value="{Binding CommissionPercentage}" Minimum="0" Maximum="100" Increment="0.1" FormatString="F1" Width="80" VerticalAlignment="Center"/>
                    
                    <Button Command="{Binding LoadReportsCommand}" Background="#10B981" Foreground="White" CornerRadius="8" Padding="14,8" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18"/>
                            <TextBlock Text="Filtrar"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Main Analytics Table -->
        <Border Grid.Row="1" Padding="20">
            <Grid RowDefinitions="*,Auto">
                <DataGrid Grid.Row="0" ItemsSource="{Binding CashierProductivityReports}" 
                          IsReadOnly="True" AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CAJERO" Binding="{Binding FullName}" Width="2*"/>
                        <DataGridTextColumn Header="ROL" Binding="{Binding Role}" Width="120"/>
                        <DataGridTextColumn Header="HRS. COMPLETADAS" Binding="{Binding TotalHoursWorked, StringFormat='{}{0:F2} hrs'}" Width="145"/>
                        <DataGridTextColumn Header="ASISTENCIA" Binding="{Binding AttendanceStatusDisplay}" Width="210"/>
                        <DataGridTextColumn Header="TICKETS" Binding="{Binding TotalTicketsProcessed}" Width="100"/>
                        <DataGridTextColumn Header="VENTA NETA" Binding="{Binding GrossSales, StringFormat='{}{0:C}'}" Width="140"/>
                        <DataGridTextColumn Header="TICKET PROMEDIO" Binding="{Binding AverageTicketValue, StringFormat='{}{0:C}'}" Width="140"/>
                        
                        <!-- TIME-WEIGHTED TRUE PERFORMANCE COLUMN (HIGHLIGHTED) -->
                        <DataGridTextColumn Header="VENTA / HORA REAL" 
                                            Binding="{Binding TrueSalesPerHourDisplay}"
                                            Width="160"
                                            FontWeight="Bold"
                                            Foreground="#10B981"/>

                        <DataGridTextColumn Header="TICKETS / HORA" Binding="{Binding TicketsPerHourDisplay}" Width="130"/>
                        <DataGridTextColumn Header="{Binding CommissionPercentage, StringFormat='COMISIÓN EST. ({0:F1}%)'}" Binding="{Binding EstimatedCommissionDisplay}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer Status -->
                <TextBlock Grid.Row="1" Text="{Binding FeedbackMessage}" Foreground="#94A3B8" Margin="0,12,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

