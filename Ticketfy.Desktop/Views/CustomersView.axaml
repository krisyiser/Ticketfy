<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Ticketfy.Controls"
             x:Class="Ticketfy.Views.CustomersView"
             x:DataType="vm:CustomersViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">

        <!-- ═══ TOP FUNCTION BANNER BAR ═══ -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="16,12"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource AccentPrimaryBrush}">
                        <mi:MaterialIcon Kind="AccountGroup" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Directorio de Clientes y Créditos" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Gestión de Saldos, Abonos, Estados de Cuenta y Puntos de Lealtad" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons Header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="AddCustomerBtn" Command="{Binding OpenAddCustomerDialogCommand}" Classes="primary-action" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="AccountPlus" Width="18" Height="18" />
                            <TextBlock Text="+ NUEVO CLIENTE" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Notification Banner -->
        <controls:AlertBannerControl Grid.Row="1" Message="{Binding FeedbackMessage, Mode=TwoWay}" IsError="{Binding IsFeedbackError}" Margin="0,0,0,12" />

        <!-- Search Bar -->
        <Border x:Name="CustomersSearchBorder" Grid.Row="2" Margin="0,0,0,16" Padding="12,8"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid ColumnDefinitions="*,Auto">
                <Border CornerRadius="4" Padding="12,6" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="Buscar cliente por nombre o teléfono..." Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Customers DataGrid -->
        <Border x:Name="CustomersDataGridBorder" Grid.Row="3" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="1">
            <DataGrid ItemsSource="{Binding Customers}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre del Cliente" Binding="{Binding Name}" Width="2.5*" />
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="1.2*" />
                    <DataGridTextColumn Header="Límite de Crédito" Binding="{Binding CreditLimit, StringFormat='${0:N2}'}" Width="1.5*" />
                    <DataGridTextColumn Header="Deuda Pendiente" Binding="{Binding Debt, StringFormat='${0:N2}'}" Width="1.5*" />

                    <!-- Crédito Disponible con badge de color -->
                    <DataGridTemplateColumn Header="Crédito Disponible" Width="1.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="dto:CustomerDto">
                                <Border CornerRadius="4" Padding="6,2" Margin="4,3" HorizontalAlignment="Left"
                                        Background="#ECFDF5">
                                    <TextBlock Text="{Binding AvailableCredit, StringFormat='${0:N2}'}"
                                               FontWeight="Bold" FontSize="12" FontFamily="Consolas, monospace"
                                               Foreground="#059669"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Puntos Acumulados" Binding="{Binding PuntosSaldo, StringFormat='{}{0:N0} pts'}" Width="1.3*" />

                    <DataGridTemplateColumn Header="Acciones de Crédito y Cuenta" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="dto:CustomerDto">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Command="{Binding $parent[UserControl].((vm:CustomersViewModel)DataContext).OpenAddPaymentDialogCommand}"
                                            CommandParameter="{Binding}"
                                            Content="ABONAR" Padding="8,4" FontSize="11" FontWeight="Bold"
                                            Classes="success-action" CornerRadius="4" />

                                    <Button Command="{Binding $parent[UserControl].((vm:CustomersViewModel)DataContext).OpenStatementDialogCommand}"
                                            CommandParameter="{Binding}"
                                            Content="ESTADO DE CUENTA" Padding="8,4" FontSize="11" FontWeight="Bold"
                                            Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" Foreground="{DynamicResource AccentPrimaryBrush}" CornerRadius="4" />

                                    <Button Command="{Binding $parent[UserControl].((vm:CustomersViewModel)DataContext).OpenEditCustomerDialogCommand}"
                                            CommandParameter="{Binding}"
                                            Content="EDITAR" Padding="8,4" FontSize="11" FontWeight="Bold"
                                            Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" CornerRadius="4" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

            </DataGrid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="Anterior" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" />
            <TextBlock Text="{Binding PageDescription}" VerticalAlignment="Center" />
            <Button Content="Siguiente" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" />
        </StackPanel>
    </Grid>
</UserControl>

