<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels.Dialogs"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Ticketfy.Controls"
             xmlns:converters="using:Ticketfy.Converters"
             x:Class="Ticketfy.Views.Dialogs.ItemKitDialog"
             x:DataType="vm:ItemKitDialogViewModel">

    <UserControl.Resources>
        <converters:StringToDoubleConverter x:Key="StringToDoubleConverter"/>
    </UserControl.Resources>

    <Grid Background="#80000000">
        <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}" Padding="20">
            <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="PackageVariantClosed" Width="22" Height="22" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CancelCommand}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0">
                        <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" />

                <TextBlock Text="{Binding ActivationNotice}" TextWrapping="Wrap" />
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" IsEnabled="{Binding CanEditFields}">
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,8" Spacing="4">
                        <TextBlock Text="Código de Barras Combo / Promoción" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="KitBarcodeField" Text="{Binding KitBarcode, Mode=TwoWay}" Watermark="Opcional: genera código interno COMBO" Padding="8" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,8" Spacing="4">
                        <TextBlock Text="Nombre del Combo / Promoción *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="KitNameField" Text="{Binding KitName, Mode=TwoWay}" Watermark="Ej. Paquete desayuno" Padding="8" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                        <TextBlock Text="Precio Especial ($ MXN) *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <controls:NumericTextBox AllowDecimals="True" Text="{Binding KitPrice, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}" Watermark="0.00" Padding="8" FontSize="14" FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0" Spacing="4">
                        <TextBlock Text="Descripción / Notas" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding KitDescription, Mode=TwoWay}" Watermark="Incluye productos seleccionados" Padding="8" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Agregar Productos Ingredientes al Combo" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding CanEditFields}">
                    <TextBox Text="{Binding ProductSearch}" Watermark="Buscar producto por nombre o código" />
                    <Button Grid.Column="1" Content="Buscar" Command="{Binding LoadProductsCommand}" />
                </Grid>
                <TextBlock Text="{Binding CatalogMessage}" TextWrapping="Wrap" FontSize="11" />
                <Grid ColumnDefinitions="*,80,Auto" IsEnabled="{Binding CanEditFields}">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:ProductDto">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <controls:NumericTextBox Grid.Column="1" AllowDecimals="True" Text="{Binding ItemQuantity, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}" Watermark="Cant." Margin="4,0" Padding="8" />
                    <Button Grid.Column="2" Command="{Binding AddItemToDraftCommand}" Content="+ AGREGAR" Padding="10,8" CornerRadius="{DynamicResource AppCornerRadius}" Classes="primary-action" FontWeight="Bold" />
                </Grid>

                <!-- Ingredients Table -->
                <ScrollViewer Height="140" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEditFields}">
                    <ItemsControl ItemsSource="{Binding DraftKitItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:ItemKitItemDto">
                                <Border Margin="0,0,0,4" Padding="10,6" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='Cantidad: {0}'}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                        <Button Grid.Column="2" Command="{Binding $parent[UserControl].((vm:ItemKitDialogViewModel)DataContext).RemoveItemFromDraftCommand}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="2">
                                            <mi:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource AccentDangerBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <controls:AlertBannerControl Message="{Binding FeedbackMessage}" IsError="True" />

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Command="{Binding CancelCommand}" Content="{Binding CloseButtonText}" Padding="16,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" />
                    <Button x:Name="SaveKitButton" Command="{Binding SaveKitCommand}" Content="{Binding SaveButtonText}" Padding="16,8" CornerRadius="{DynamicResource AppCornerRadius}" Classes="success-action" FontWeight="Bold" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

