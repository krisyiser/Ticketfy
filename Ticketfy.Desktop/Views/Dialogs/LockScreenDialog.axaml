<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels.Dialogs"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Views.Dialogs.LockScreenDialog"
             x:DataType="vm:LockScreenDialogViewModel">

    <Grid Background="#E60F172A">
        <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="12" Padding="28">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Border Background="#EFF6FF" CornerRadius="40" Width="64" Height="64" HorizontalAlignment="Center">
                    <mi:MaterialIcon Kind="LockOutline" Width="32" Height="32" Foreground="#2563EB" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="Terminal Bloqueada" FontSize="20" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CashierName, StringFormat='Cajero: {0}'}" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Use la contraseña del usuario de esta sesión. El PIN sólo sirve durante 15 minutos desde una verificación primaria en esta ejecución." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center"/>
                <CheckBox IsChecked="{Binding UsePassword}" Content="Usar contraseña" />
                <StackPanel Spacing="8" IsVisible="{Binding UsePassword}">
                    <TextBox Text="{Binding Password}" PasswordChar="•" MaxLength="1024" Watermark="Contraseña" />
                    <Button Command="{Binding VerifyPasswordCommand}" Content="Verificar y desbloquear" />
                </StackPanel>

                <Border IsVisible="{Binding !UsePassword}" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="48" Width="220">
                    <TextBlock Text="{Binding MaskedPin}" FontSize="24" FontWeight="Bold" LetterSpacing="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F172A"/>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="350"/>

                <!-- Numeric Keypad -->
                <Grid IsVisible="{Binding !UsePassword}" RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, Auto, Auto" HorizontalAlignment="Center">
                    <Button Grid.Row="0" Grid.Column="0" Content="1" Command="{Binding AppendPinDigitCommand}" CommandParameter="1" Margin="6" Width="64" Height="64" CornerRadius="32" FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F1F5F9" Foreground="#0F172A"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Command="{Binding AppendPinDigitCommand}" CommandParameter="2" Margin="6" Width="64" Height="64" CornerRadius="32" FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F1F5F9" Foreground="#0F172A"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Command="{Binding AppendPinDigitCommand}" CommandParameter="3" Margin="6" Width="64" Height="64" CornerRadius="32" FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F1F5F9" Foreground="#0F172A"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="4" Command="{Binding AppendPinDigitCommand}" CommandParameter="4" Margin="6" Width="64" Height="64" CornerRadius="32" FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F1F5F9" Foreground="#0F172A"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Command="{Binding AppendPinDigitCommand}" CommandParameter="5" Margin="6" Width="64" Height="64" CornerRadius="32" FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F1F5F9" Foreground="#0F172A"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Command="{Binding AppendPinDigitCommand}" CommandParameter="6" Margin="6" Width="64" Height="64" CornerRadius="32" FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F1F5F9" Foreground="#0F172A"/>

                    <Button Grid.Row="2" Grid.Column="0" Content="7" Command="{Binding AppendPinDigitCommand}" CommandParameter="7" Margin="6" Width="64" Height="64" CornerRadius="32" FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F1F5F9" Foreground="#0F172A"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Command="{Binding AppendPinDigitCommand}" CommandParameter="8" Margin="6" Width="64" Height="64" CornerRadius="32" FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F1F5F9" Foreground="#0F172A"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Command="{Binding AppendPinDigitCommand}" CommandParameter="9" Margin="6" Width="64" Height="64" CornerRadius="32" FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F1F5F9" Foreground="#0F172A"/>

                    <Button Grid.Row="3" Grid.Column="0" Content="C" Command="{Binding ClearPinCommand}" Margin="6" Width="64" Height="64" CornerRadius="32" FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#FEF2F2" Foreground="#EF4444"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Command="{Binding AppendPinDigitCommand}" CommandParameter="0" Margin="6" Width="64" Height="64" CornerRadius="32" FontSize="24" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F1F5F9" Foreground="#0F172A"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

