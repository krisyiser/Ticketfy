<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels.Dialogs"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Ticketfy.Controls"
             x:Class="Ticketfy.Views.Dialogs.OpenShiftDialog"
             x:DataType="vm:OpenShiftDialogViewModel">

    <Grid Background="#80000000">
        <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}" Padding="24">
            <StackPanel Spacing="16">
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <mi:MaterialIcon Kind="StorefrontOutline" Width="24" Height="24" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    <StackPanel>
                        <TextBlock Text="Apertura de Turno" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Declare el fondo inicial de caja para continuar" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource BorderBrush}" />

                <!-- Input Field -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Fondo Inicial" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <controls:NumericTextBox x:Name="FloatInput" AllowDecimals="True" Text="{Binding InitialFloatAmount, Mode=TwoWay}" Watermark="0.00" Padding="12" FontSize="16" Height="46" VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource AccentDangerBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" />

                <!-- Buttons -->
                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Administrar sin turno" Margin="0,0,6,0" Padding="12" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button Grid.Column="1" Command="{Binding OpenShiftCommand}" Content="Iniciar Turno" Margin="6,0,0,0" Padding="12" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="primary-action" FontWeight="Bold" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

