<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels.Dialogs"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Ticketfy.Controls"
             xmlns:converters="using:Ticketfy.Converters"
             x:Class="Ticketfy.Views.Dialogs.ProductDialog"
             x:DataType="vm:ProductDialogViewModel">

    <UserControl.Resources>
        <converters:StringToDoubleConverter x:Key="StringToDoubleConverter"/>
    </UserControl.Resources>

    <Border Width="540" Padding="24" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,20">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Código, descripción, precios y niveles de inventario del producto." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0" Spacing="12">
                <controls:AlertBannerControl Message="{Binding ErrorMessage}" IsError="True" />

                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Cancelar" Margin="0,0,6,0" Padding="12"
                            Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Foreground="{DynamicResource TextPrimaryBrush}" CornerRadius="6" HorizontalContentAlignment="Center" />

                    <Button Grid.Column="1" Command="{Binding SaveCommand}" Content="Guardar Producto" Margin="6,0,0,0" Padding="12"
                            Classes="primary-action" FontWeight="Bold" CornerRadius="6" HorizontalContentAlignment="Center" />
                </Grid>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="0,0,12,0" Margin="0,0,-12,0">
                <StackPanel Spacing="16">
                    
                    <!-- AUTOFILL BANNER -->
                    <Border IsVisible="{Binding ShowAutoFillBanner}" 
                            Background="#E0F2FE" BorderBrush="#3B82F6" BorderThickness="1" 
                            CornerRadius="6" Padding="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="CloudDownload" Width="20" Height="20" Foreground="#0284C7"/>
                            <TextBlock Text="¡Información precargada desde el catálogo global! Revisa el precio y guarda." 
                                       Foreground="#0369A1" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 1. DATOS GENERALES -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Background="{DynamicResource BgTertiaryBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Datos Generales" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,6"/>
                            
                            <StackPanel Spacing="4">
                                <TextBlock Text="Nombre del Producto *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="Ej. Leche Entera 1 Litro" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                    <TextBlock Text="Código de Barras / SKU *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding Barcode, Mode=TwoWay}" Watermark="Ej. 7501000000001" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding GenerateBarcodeCommand}" Content="Generar SKU" VerticalAlignment="Bottom" Padding="12,8"
                                        Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                    <TextBlock Text="Categoría" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4" Margin="2,0,2,0">
                                    <TextBlock Text="Unidad de Medida *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4" Margin="4,0,0,0">
                                    <TextBlock Text="Proveedor" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}" DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Text="{Binding SupplierSearch}" Watermark="Buscar proveedor por nombre" />
                                <Button Grid.Column="1" Content="Buscar" Command="{Binding SearchSuppliersCommand}" Margin="6,0" />
                                <Button Grid.Column="2" Content="Sin proveedor" Command="{Binding ClearSupplierCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding SupplierLookupMessage}" TextWrapping="Wrap" FontSize="11" />

                            <!-- BULK / GRANEL INFORMATIVE BANNER (SIN CHECKBOX REDUNDANTE) -->
                            <Border IsVisible="{Binding IsBulk}" Margin="0,6,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <mi:MaterialIcon Kind="ScaleBalance" Width="20" Height="20" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Venta a Granel / Fraccionada Activada" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Este producto activará la calculadora de equivalente en peso, volumen o monto al seleccionarlo en caja (POS)." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. PRECIOS Y FINANZAS -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Background="{DynamicResource BgTertiaryBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Precios y Finanzas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,6"/>
                            
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="Costo ($) *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:NumericTextBox IsEnabled="{Binding CostsVisible}" AllowDecimals="True" Text="{Binding CostPrice, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}" Watermark="0.00" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                    <TextBlock Text="Precio Venta ($) *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:NumericTextBox AllowDecimals="True" Text="{Binding RetailPrice, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}" Watermark="0.00" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>
                            </Grid>

                            <!-- REACTIVE MARGIN BADGE -->
                            <TextBlock Text="{Binding ProfitMargin}" Foreground="{DynamicResource AccentSuccessBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. CONTROL DE INVENTARIO Y SAT -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Background="{DynamicResource BgTertiaryBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Control de Inventario y SAT" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding StockAdjustmentReason}" Watermark="Motivo obligatorio al ajustar existencias" />
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel><TextBlock Text="Existencia máxima (0 = sin límite)" /><NumericUpDown Value="{Binding MaxStock}" Minimum="0" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Tasa de IVA (0.16 = 16%)" /><NumericUpDown Value="{Binding TaxRate}" Minimum="0" Maximum="1" Increment="0.01" /></StackPanel>
                            </Grid>
                            
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="Stock Actual *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:NumericTextBox AllowDecimals="True" Text="{Binding Stock, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}" Watermark="0.00" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                    <TextBlock Text="Stock Mínimo (Alerta) *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:NumericTextBox AllowDecimals="True" Text="{Binding MinStock, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}" Watermark="0.00" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                    <TextBlock Text="Puntos Regalo" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:NumericTextBox AllowDecimals="True" Text="{Binding PointsRewarded, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}" Watermark="0.0" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4" Margin="2,0,2,0">
                                    <TextBlock Text="Cant. Reorden" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" />
                                    <controls:NumericTextBox AllowDecimals="True" Text="{Binding ReorderQuantity, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}" Watermark="0.0" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4" Margin="4,0,0,0">
                                    <TextBlock Text="Pasillo / Rack" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding LocationRack, Mode=TwoWay}" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="Clave Prod SAT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding SatProductCode, Mode=TwoWay}" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                    <TextBlock Text="Clave Unidad SAT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding SatUnitCode, Mode=TwoWay}" Background="{DynamicResource BgSecondaryBrush}" Padding="8" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

