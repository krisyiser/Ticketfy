<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels.Dialogs"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Ticketfy.Controls"
             xmlns:converters="using:Ticketfy.Converters"
             x:Class="Ticketfy.Views.Dialogs.ReturnDialog"
             x:DataType="vm:ReturnDialogViewModel">

    <UserControl.Resources>
        <converters:StringToDoubleConverter x:Key="StringToDoubleConverter"/>
    </UserControl.Resources>

    <Grid Background="#80000000">
        <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}" Padding="20">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="KeyboardReturn" Width="22" Height="22" Foreground="{DynamicResource AccentDangerBrush}" />
                        <TextBlock Text="Devolución de Producto" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CancelCommand}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0">
                        <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" />

                <Grid ColumnDefinitions="*,*">
                    <TextBlock Text="{Binding SaleId, StringFormat='Folio Venta: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding SaleDate, StringFormat='Fecha: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Seleccionar Producto del Ticket *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:SaleItemSnapshotDto">
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} (Comprado: {1:N1} pza @ ${2:N2})">
                                            <Binding Path="Name"/>
                                            <Binding Path="Quantity"/>
                                            <Binding Path="UnitPrice"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Grid RowDefinitions="Auto" ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                        <TextBlock Text="Cantidad a Devolver *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <controls:NumericTextBox AllowDecimals="True" Text="{Binding ReturnQuantity, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}" Watermark="1.0" Padding="8" FontSize="14" FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="4">
                        <TextBlock Text="Método de Reembolso *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="A los medios originales. Tarjetas y transferencias quedan pendientes hasta su conciliación bancaria." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Motivo de la Devolución *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding ReturnReason, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8" />
                </StackPanel>

                <CheckBox IsChecked="{Binding IsProductInGoodCondition, Mode=TwoWay}" Margin="0,4,0,0">
                    <TextBlock Text="Producto en buen estado (Reingresar a inventario)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                </CheckBox>

                <controls:AlertBannerControl Message="{Binding FeedbackMessage}" IsError="True" />

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Command="{Binding CancelCommand}" Content="Cancelar" Padding="16,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" />
                    <Button Command="{Binding ProcessReturnCommand}" Content="PROCESAR DEVOLUCIÓN" Padding="16,8" CornerRadius="{DynamicResource AppCornerRadius}" Classes="danger-action" FontWeight="Bold" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

