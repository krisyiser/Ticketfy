<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels.Dialogs"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Views.Dialogs.ShiftNotesDialog"
             x:DataType="vm:ShiftNotesDialogViewModel">

    <Grid Background="#80000000">
        <Border Width="640" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}" Padding="20">
            <DockPanel LastChildFill="True">

                <!-- Header -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="NotebookOutline" Width="22" Height="22" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Gestor de Notas &amp; Avisos de Turno entre Cajeros" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Historial completo de avisos, instrucciones, ediciones y eliminaciones de turno" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding CloseCommand}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0">
                        <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>

                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                <!-- Bottom Input Form -->
                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,140,Auto">
                            <TextBox Grid.Column="0" Text="{Binding NewNoteText, Mode=TwoWay}" Watermark="Escriba la nota de turno (Ej. 'Se dejaron $300 de cambio en monedas de $10')..." Padding="8" FontSize="12" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" Margin="6,0" Padding="6" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Command="{Binding SaveNoteCommand}" Classes="primary-action" Padding="14,8" FontWeight="Bold">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                    <TextBlock Text="Guardar Nota" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding FeedbackMessage}" FontSize="12" Foreground="{DynamicResource AccentSuccessBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}" Content="Cancelar Edición" Padding="8,4" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentDangerBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Middle Scrollable Notes List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:ShiftNoteDto">
                                <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding CashierName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <TextBlock Text="{Binding CreatedAt}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Background="{DynamicResource BgSecondaryBrush}">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding NoteText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <!-- Resolve / Complete Button -->
                                            <Button Command="{Binding $parent[UserControl].((vm:ShiftNotesDialogViewModel)DataContext).ToggleResolveNoteCommand}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" ToolTip.Tip="Marcar como atendida / resuelta">
                                                <mi:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="{DynamicResource AccentSuccessBrush}" />
                                            </Button>

                                            <!-- Edit Button -->
                                            <Button Command="{Binding $parent[UserControl].((vm:ShiftNotesDialogViewModel)DataContext).StartEditNoteCommand}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" ToolTip.Tip="Editar nota">
                                                <mi:MaterialIcon Kind="Pencil" Width="18" Height="18" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Command="{Binding $parent[UserControl].((vm:ShiftNotesDialogViewModel)DataContext).DeleteNoteCommand}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" ToolTip.Tip="Cancelar nota (conserva historial)">
                                                <mi:MaterialIcon Kind="Delete" Width="18" Height="18" Foreground="{DynamicResource AccentDangerBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

