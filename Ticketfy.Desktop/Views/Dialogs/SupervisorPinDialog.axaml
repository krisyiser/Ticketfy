<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels.Dialogs"
             x:Class="Ticketfy.Views.Dialogs.SupervisorPinDialog"
             x:DataType="vm:SupervisorPinDialogViewModel">
    <Border Width="440" Padding="24" Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding ActionTitle}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="Esta acción requiere la contraseña de un supervisor, gerente o administrador autorizado. El acceso rápido por PIN no autoriza acciones sensibles." TextWrapping="Wrap" />
            <TextBox Text="{Binding Username}" Watermark="Usuario del supervisor" MaxLength="128" />
            <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="Contraseña" MaxLength="1024" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AccentDangerBrush}" />
            <Button Command="{Binding ApproveCommand}" Content="Verificar contraseña y autorizar" IsEnabled="{Binding !IsVerifying}" HorizontalAlignment="Stretch" />
            <Button Command="{Binding CancelCommand}" Content="Cancelar" HorizontalAlignment="Stretch" />
        </StackPanel>
    </Border>
</UserControl>
