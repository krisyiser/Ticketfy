<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Ticketfy.Controls"
             xmlns:converters="using:Ticketfy.Converters"
             x:Class="Ticketfy.Views.Expenses.ExpenseEntryView"
             x:DataType="vm:ExpensesViewModel">

    <UserControl.Resources>
        <converters:StringToDoubleConverter x:Key="StringToDoubleConverter"/>
    </UserControl.Resources>

    <!-- Main Workspace (Left: Register Expense Form, Right: Expenses Table) -->
    <Grid ColumnDefinitions="360,*">
        <!-- Left: Add Expense Form -->
        <Border x:Name="ExpenseEntryForm" Grid.Column="0" Margin="0,0,16,0" Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <StackPanel Spacing="12">
                <TextBlock Text="Registrar Salida / Gasto de Caja" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Border Height="1" Background="{DynamicResource BorderBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Categoría de Gasto" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Monto ($ MXN) *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <controls:NumericTextBox AllowDecimals="True" Text="{Binding ExpenseAmount, Mode=TwoWay, Converter={StaticResource StringToDoubleConverter}}" Watermark="0.00" Padding="10,8" FontSize="15" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Forma de Pago" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8" />
                    <TextBox Text="{Binding ExpenseReference}" Watermark="Referencia / comprobante de pago" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Concepto / Descripción" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding ExpenseDescription, Mode=TwoWay}" Watermark="Ej. Pago de luz local comercial mes en curso" AcceptsReturn="True" Height="70" Padding="10,8" />
                </StackPanel>

                <Button Command="{Binding AddExpenseCommand}" Content="REGISTRAR GASTO" Padding="16,12" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource AccentDangerBrush}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Right: Expenses History Table -->
        <Border x:Name="ExpenseHistoryContainer" Grid.Column="1" Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Historial de Gastos Registrados" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
                    <TextBox Text="{Binding CancellationReason}" Watermark="Motivo obligatorio para cancelar un gasto" />
                    <CheckBox IsChecked="{Binding ReversalVerified}" Content="Confirmo la devolución del efectivo a esta caja / el abono bancario" />
                    <TextBlock Text="No cancele un gasto pagado si el dinero no ha sido restituido." TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Expenses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:ExpenseDto">
                                <Border Margin="0,0,0,6" Padding="14,10" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="140,*,120,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <TextBlock Text="{Binding Date}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="{Binding Description}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="CANCELADO · original conservado" IsVisible="{Binding IsCancelled}" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='-${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentDangerBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0" />
                                        <Button Grid.Column="3" IsEnabled="{Binding !IsCancelled}" Command="{Binding $parent[UserControl].((vm:ExpensesViewModel)DataContext).DeleteExpenseCommand}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" ToolTip.Tip="Cancelar con restitución verificada">
                                            <mi:MaterialIcon Kind="Cancel" Width="18" Height="18" Foreground="{DynamicResource AccentDangerBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

