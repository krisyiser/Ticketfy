<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             x:Class="Ticketfy.Views.Expenses.NetProfitAnalyticsView"
             x:DataType="vm:ExpensesViewModel">

    <!-- Financial Metrics Cards (Fondo Inicial, Ingresos, Pagos con Tarjeta, Egresos, Total en Caja, Costo de Ventas, Utilidad Neta) -->
    <UniformGrid x:Name="FinancialBalanceSection" Columns="7">
        
        <!-- 1. FONDO INICIAL (APERTURA) -->
        <Border Margin="0,0,2,0" Padding="10" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <StackPanel Spacing="4">
                <TextBlock Text="Fondo Inicial (Apertura)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" ToolTip.Tip="Monto con el que se abrió la caja en el turno activo" />
                <TextBlock Text="{Binding FondoInicial, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 2. INGRESOS (VENTAS) -->
        <Border Margin="2,0" Padding="10" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <StackPanel Spacing="4">
                <TextBlock Text="Ingresos (Ventas)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" ToolTip.Tip="Total bruto de ventas del turno activo (Efectivo + Tarjetas)" />
                <TextBlock Text="{Binding Ingresos, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" />
            </StackPanel>
        </Border>

        <!-- 3. EGRESOS (GASTOS) -->
        <Border Margin="2,0" Padding="10" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <StackPanel Spacing="4">
                <TextBlock Text="Egresos (Gastos)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" ToolTip.Tip="Gastos operativos registrados en el turno" />
                <TextBlock Text="{Binding Egresos, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentDangerBrush}" />
            </StackPanel>
        </Border>

        <!-- 4. PAGOS CON TARJETA / TRANSF. -->
        <Border Margin="2,0" Padding="10" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <StackPanel Spacing="4">
                <TextBlock Text="Pagos con Tarjeta / Transf." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" ToolTip.Tip="Ventas cobradas con Tarjeta, Débito, Crédito o Transferencias" />
                <TextBlock Text="{Binding PagosConTarjeta, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="#3B82F6" />
            </StackPanel>
        </Border>

        <!-- 5. TOTAL EN CAJA FÍSICO -->
        <Border Margin="2,0" Padding="10" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="2" CornerRadius="{DynamicResource AppCornerRadius}">
            <StackPanel Spacing="4">
                <TextBlock Text="Efectivo esperado: turno actual" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" ToolTip.Tip="Fondo inicial más todos los movimientos del turno. No sustituye el arqueo físico." />
                <TextBlock Text="{Binding TotalEnCaja, StringFormat='${0:N2}'}" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 6. COSTO DE VENTAS (MERCANCÍA) -->
        <Border Margin="2,0" Padding="10" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <StackPanel Spacing="4">
                <TextBlock Text="Costo de Ventas" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" ToolTip.Tip="Costo de inversión/compra de los productos vendidos (COGS)" />
                <TextBlock Text="{Binding CostoDeVentas, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- 7. UTILIDAD NETA (GANANCIA) -->
        <Border Margin="2,0,0,0" Padding="10" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{Binding UtilidadNetaColor}" BorderThickness="2" CornerRadius="{DynamicResource AppCornerRadius}">
            <StackPanel Spacing="4">
                <TextBlock Text="Utilidad Neta (Ganancia)" FontSize="11" FontWeight="Bold" Foreground="{Binding UtilidadNetaColor}" ToolTip.Tip="Ventas - Costo de Productos - Gastos Operativos" />
                <TextBlock Text="{Binding UtilidadNeta, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{Binding UtilidadNetaColor}" />
            </StackPanel>
        </Border>
    </UniformGrid>
</UserControl>

