<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Ticketfy.Controls"
             xmlns:expenses="using:Ticketfy.Views.Expenses"
             x:Class="Ticketfy.Views.ExpensesView"
             x:DataType="vm:ExpensesViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="16,12"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource AccentDangerBrush}">
                        <mi:MaterialIcon Kind="CashMinus" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Gastos operativos y resultado comercial" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding PeriodSubtitleDisplay}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Period Selector ComboBox -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Filtrar Período:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}" Width="160" Padding="8,6" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Direct Cash Cutoff / Reset Button -->
                <Button Grid.Column="2" Command="{Binding PerformCashCutoffCommand}"
                        ToolTip.Tip="Contar el efectivo y cerrar el turno actual. El historial y los totales de otros períodos se conservan."
                        Padding="12,8" CornerRadius="{DynamicResource AppCornerRadius}"
                        Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource AccentWarningBrush}" BorderThickness="1.5" Cursor="Hand" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="CashRegister" Width="18" Height="18" Foreground="{DynamicResource AccentWarningBrush}" />
                        <TextBlock Text="CORTE DE CAJA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Notification Banner -->
        <controls:AlertBannerControl Grid.Row="1" Message="{Binding FeedbackMessage, Mode=TwoWay}" IsError="{Binding IsFeedbackError}" Margin="0,0,0,12" />

        <!-- 2. Financial Metrics Cards -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16" Spacing="8">
            <TextBlock Text="{Binding ReadMessage}" TextWrapping="Wrap" />
            <expenses:NetProfitAnalyticsView IsVisible="{Binding FinancialVisible}" />
        </StackPanel>

        <!-- 3. Main Workspace -->
        <expenses:ExpenseEntryView Grid.Row="3" />

    </Grid>
</UserControl>

