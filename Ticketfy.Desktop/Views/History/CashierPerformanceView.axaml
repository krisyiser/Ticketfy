<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Views.History.CashierPerformanceView"
             x:DataType="vm:HistoryViewModel">

    <!-- Cashier Performance & Commission Leaderboard Card -->
    <Border Padding="14" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="AccountTie" Width="18" Height="18" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Rendimiento &amp; Comisiones" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Comisión:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <NumericUpDown Value="{Binding CommissionPercentage}" ShowButtonSpinner="False" Minimum="0" Maximum="100" FormatString="0.#'%' " Width="85" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="8,6" ToolTip.Tip="Ingresa el porcentaje de comisión (solo dígitos, ej. 15 -> 15%)" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding LoadCashierPerformanceCommand}" Padding="8,4" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <mi:MaterialIcon Kind="Refresh" Width="14" Height="14" Foreground="{DynamicResource AccentPrimaryBrush}" />
                </Button>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="110">
                <ItemsControl ItemsSource="{Binding CashierPerformanceReport}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:CashierPerformanceDto">
                            <Border Margin="0,0,0,4" Padding="10,6" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding CashierName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding TicketCount, StringFormat='{}{0} Tkts'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding AverageTicketValue, StringFormat='Ticket Prom: ${0:N2}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding TotalRevenue, StringFormat='Venta: ${0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                    <Border Grid.Column="4" Background="#10B981" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EarnedCommissionDisplay, StringFormat='Comisión: {0}'}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

