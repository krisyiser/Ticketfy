<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:entity="using:Ticketfy.Data.Entities"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Views.History.HistoryCashupsTableView"
             x:DataType="vm:HistoryViewModel">

    <Grid>
        <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="16">
            <Grid RowDefinitions="Auto,Auto,*">
                <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,12">
                    <TextBlock Text="Registro de cortes de caja y cortes de turno" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Anterior" Command="{Binding PreviousCashupPageCommand}" IsEnabled="{Binding HasPreviousCashups}" />
                        <TextBlock Text="{Binding CashupPageLabel}" VerticalAlignment="Center" />
                        <Button Content="Siguiente" Command="{Binding NextCashupPageCommand}" IsEnabled="{Binding HasMoreCashups}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding CashupFeedbackMessage}" TextWrapping="Wrap" Margin="0,0,0,8" />

                <DataGrid Grid.Row="2" ItemsSource="{Binding Cashups}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha / Hora" Binding="{Binding LocalDateDisplay}" Width="1.3*" />
                        <DataGridTextColumn Header="Cajero / Usuario" Binding="{Binding CashierName}" Width="1.4*" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="0.9*" />
                        <DataGridTextColumn Header="Fondo Inicial" Binding="{Binding OpenCashAmount, StringFormat='${0:N2}'}" Width="1.1*" />
                        <DataGridTextColumn Header="Ventas en efectivo" Binding="{Binding TotalSalesDisplay}" Width="1.2*" />
                        <DataGridTextColumn Header="Salidas de efectivo" Binding="{Binding TotalExpensesDisplay}" Width="1.1*" />
                        <DataGridTextColumn Header="Verificación" Binding="{Binding BreakdownStatus}" Width="1.5*" />
                        <DataGridTextColumn Header="Diferencia" Binding="{Binding Difference, StringFormat='${0:N2}'}" Width="1.1*" />
                        <DataGridTextColumn Header="Conteo Físico Total en Caja" Binding="{Binding ClosedCashAmount, StringFormat='${0:N2}'}" Width="1.5*" />
                        <DataGridTemplateColumn Header="Acciones" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="entity:CashupEntity">
                                    <Button Command="{Binding $parent[DataGrid].((vm:HistoryViewModel)DataContext).ViewCashupDetailCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4" CornerRadius="4" Margin="2"
                                            ToolTip.Tip="Ver reporte detallado de este corte"
                                            Background="{DynamicResource BgTertiaryBrush}"
                                            BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <mi:MaterialIcon Kind="Eye" Width="13" Height="13" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <TextBlock Text="Ver Detalle" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══ DETALLE DE CORTE DE CAJA MODAL DIALOG ═══ -->
        <Border Background="#80000000" IsVisible="{Binding IsCashupDetailDialogOpen}" Padding="20">
            <Border Width="720" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
                    Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
                <DockPanel LastChildFill="True" DataContext="{Binding SelectedCashupForDetail}">
                    <!-- Title Bar -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,18">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                <Border Background="{DynamicResource BgTertiaryBrush}" CornerRadius="8" Padding="10">
                                    <mi:MaterialIcon Kind="CashRegister" Width="24" Height="24" Foreground="{DynamicResource AccentWarningBrush}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Reporte Detallado de Corte de Caja y Turno" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding LocalDateDisplay, StringFormat='Fecha de Registro: {0}'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Badge Tipo de Corte (Separado en la cabecera sin solapamientos) -->
                            <Border Grid.Column="1" Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="6" Padding="10,5" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Type, TargetNullValue='CORTE FINAL'}" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>

                            <Button Grid.Column="2" Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).CloseCashupDetailCommand}" Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand">
                                <mi:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextMutedBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Bottom Action Buttons -->
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
                        <Button Grid.Column="1" Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).PrintCashupTicketCommand}"
                                CommandParameter="{Binding}" Padding="14,8" Margin="0,0,10,0" CornerRadius="{DynamicResource AppCornerRadius}"
                                Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="Printer" Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                <TextBlock Text="REIMPRIMIR TICKET" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).CloseCashupDetailCommand}"
                                Content="CERRAR" Padding="18,8" CornerRadius="{DynamicResource AppCornerRadius}" Classes="primary-action" FontWeight="Bold" Cursor="Hand" />
                    </Grid>

                    <!-- Detailed Content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Responsible Cashier & Key Metrics Section -->
                            <Border Background="{DynamicResource BgPrimaryBrush}" Padding="16" CornerRadius="{DynamicResource AppCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <!-- Cashier Info Bar -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Cajero Responsable:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CashierName, TargetNullValue='Sin Asignar'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CashierRole, StringFormat='({0})', TargetNullValue=''}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderBrush}" />

                                    <!-- 5 Key Metrics Cards Grid -->
                                    <Grid ColumnDefinitions="*,*,*,*,*">
                                        <Border Grid.Column="0" Margin="0,0,4,0" Padding="8" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="1. Fondo Inicial" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding OpenCashAmount, StringFormat='${0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Margin="2,0" Padding="8" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="2. Ventas en efectivo" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding TotalSalesDisplay}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Margin="2,0" Padding="8" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="3. Salidas de efectivo" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding TotalExpensesDisplay}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentDangerBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3" Margin="2,0" Padding="8" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="4. Diferencia" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding Difference, StringFormat='${0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4" Margin="4,0,0,0" Padding="8" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="5. Conteo Físico" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding ClosedCashAmount, StringFormat='${0:N2}'}" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Denomination Breakdown Grid -->
                            <TextBlock Text="Desglose Físico por Denominación" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding DenominationStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                            <Border Background="{DynamicResource BgPrimaryBrush}" Padding="16" CornerRadius="{DynamicResource AppCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                            <mi:MaterialIcon Kind="Cash" Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <TextBlock Text="Billetes" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Count1000, StringFormat='{}• $1,000: {0} piezas'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Count500, StringFormat='{}• $500: {0} piezas'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Count200, StringFormat='{}• $200: {0} piezas'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Count100, StringFormat='{}• $100: {0} piezas'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Count50, StringFormat='{}• $50: {0} piezas'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Count20, StringFormat='{}• $20: {0} piezas'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                            <mi:MaterialIcon Kind="CurrencyUsd" Width="16" Height="16" Foreground="{DynamicResource AccentWarningBrush}" />
                                            <TextBlock Text="Monedas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Count10, StringFormat='{}• $10: {0} piezas'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Count5, StringFormat='{}• $5: {0} piezas'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Count2, StringFormat='{}• $2: {0} piezas'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Count1, StringFormat='{}• $1: {0} piezas'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Count050, StringFormat='{}• $0.50: {0} piezas'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Notes Section -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Notas u Observaciones del Turno:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border Background="{DynamicResource BgPrimaryBrush}" Padding="12" CornerRadius="{DynamicResource AppCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinHeight="50">
                                    <TextBlock Text="{Binding Notes, TargetNullValue='Sin observaciones registradas para este turno.'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
