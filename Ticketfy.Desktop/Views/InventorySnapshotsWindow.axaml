<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ticketfy.ViewModels"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="Ticketfy.Views.InventorySnapshotsWindow"
        x:DataType="vm:InventorySnapshotsViewModel"
        Title="Historial de Puntos de Guardado"
        Width="900" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">
    
    <Grid RowDefinitions="Auto,*" Margin="20">
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Puntos de Guardado del Inventario" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Capturas documentales de inventario. No son respaldos recuperables ni conteos físicos verificados." FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8">
                <Button Content="Anterior" Command="{Binding PreviousPageCommand}" />
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" />
                <Button Content="Siguiente" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasMore}" />
            </StackPanel>
            <Border Background="{DynamicResource AccentSuccessBrush}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="Bold" Foreground="White"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="2*,3*">
            <!-- Left: List of snapshots -->
            <Border Grid.Column="0" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource BgSecondaryBrush}">
                <ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,5">
                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy hh:mm tt}'}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding CleanNotes}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding CleanNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="{Binding TotalItems, StringFormat='Items: {0}'}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Right: Details of selected snapshot -->
            <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource BgSecondaryBrush}" Padding="15">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" IsVisible="{Binding SelectedSnapshot, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,15">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Detalles del Punto de Guardado" FontSize="18" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Valor Total" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedSnapshot.TotalValue, StringFormat='{}{0:C}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Total Artículos" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedSnapshot.TotalItems}" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            <Button Grid.Column="1" Command="{Binding PrintSnapshotCommand}" Padding="10,6" CornerRadius="6" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="Printer" Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                    <TextBlock Text="IMPRIMIR PÁGINA" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Content="Anterior" Command="{Binding PreviousDetailPageCommand}" />
                            <TextBlock Text="{Binding DetailPageLabel}" VerticalAlignment="Center" FontSize="11" />
                            <Button Content="Siguiente" Command="{Binding NextDetailPageCommand}" IsEnabled="{Binding HasMoreDetails}" />
                        </StackPanel>
                    </StackPanel>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedSnapshot.Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Barcode}" Width="1.5*" />
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Name}" Width="3*" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding Quantity}" Width="1*" />
                            <DataGridTextColumn Header="Costo" Binding="{Binding CostPrice, StringFormat='{}{0:C}'}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

