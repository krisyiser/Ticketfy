<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Views.Pos.PosCartTicketView"
             x:DataType="vm:CartViewModel">

    <!-- Right Column Panel Container -->
    <Border x:Name="PosCartSection" Width="{DynamicResource PosCartWidth}" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- ROW 0: Customer & Header -->
            <Border x:Name="PosCustomerSelector" Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding CustomerSearch}" Watermark="Buscar cliente por nombre o código" FontSize="11" />
                        <Button Grid.Column="1" Content="Buscar" Command="{Binding SearchCustomersCommand}" Margin="4,0,0,0" Padding="6,4" />
                    </Grid>
                    <TextBlock Text="{Binding CustomerLoadMessage}" FontSize="11" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="AccountBox" Width="18" Height="18" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" Width="200" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="dto:CustomerDto">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="1" Content="+" Command="{Binding OpenCustomerSelectCommand}" Padding="8,4" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" FontWeight="Bold" CornerRadius="{DynamicResource AppCornerRadius}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Credit Status Badge — visible only when customer has a credit line configured -->
                    <Border IsVisible="{Binding HasCustomerCredit}"
                            Background="{DynamicResource BgTertiaryBrush}"
                            BorderBrush="{Binding CustomerCreditBadgeColor}"
                            BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="CreditCardCheckOutline" Width="14" Height="14"
                                             Foreground="{Binding CustomerCreditBadgeColor}"
                                             VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CustomerCreditBadgeText}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding CustomerCreditBadgeColor}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>


            <!-- ROW 1: Active Line Items (Scrollable) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CartState.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:CartItemDto">
                            <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="3,0,0,1" Padding="10,8">
                                <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                    <!-- Item Info -->
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding UnitPrice, StringFormat='${0:N2} c/u'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{DynamicResource AppFontFamily}"/>
                                    </StackPanel>

                                    <!-- Touch Stepper Quantity Controls -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                                        <Button Content="-" Command="{Binding $parent[UserControl].((vm:CartViewModel)DataContext).DecreaseQuantityCommand}" CommandParameter="{Binding}" IsEnabled="{Binding IsNotFractional}" Width="24" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="{DynamicResource AppCornerRadius}"/>
                                        <TextBlock Text="{Binding Quantity, StringFormat='{}{0:0.###}'}" Width="45" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" FontFamily="{DynamicResource AppFontFamily}"/>
                                        <Button Content="+" Command="{Binding $parent[UserControl].((vm:CartViewModel)DataContext).IncreaseQuantityCommand}" CommandParameter="{Binding}" IsEnabled="{Binding IsNotFractional}" Width="24" Height="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="{DynamicResource AppCornerRadius}"/>
                                    </StackPanel>

                                    <!-- Total Price -->
                                    <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='${0:N2}'}" 
                                               FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Width="70" TextAlignment="Right" VerticalAlignment="Center" FontFamily="{DynamicResource AppFontFamily}"/>

                                    <!-- Delete Button -->
                                    <Button Grid.Column="3" Command="{Binding $parent[UserControl].((vm:CartViewModel)DataContext).RemoveFromCartCommand}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Margin="6,0,0,0">
                                        <mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="{DynamicResource AccentDangerBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ROW 2: Fixed Financial Summary & Symmetrical Payment Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
                <StackPanel Spacing="10">
                    <!-- Subtotal, Discount, Tax -->
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Antes de promociones:" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CartState.Subtotal, StringFormat='${0:N2}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource AppFontFamily}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Promociones:" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="PromotionDiscountTotal" Grid.Row="1" Grid.Column="1" Text="{Binding CartState.DiscountTotal, StringFormat='-${0:N2}'}" Foreground="{DynamicResource AccentDangerBrush}" FontFamily="{DynamicResource AppFontFamily}"/>
                    </Grid>
                    <TextBlock Text="Precios con impuestos incluidos" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>

                    <Separator Background="{DynamicResource BorderBrush}" Height="1"/>

                    <!-- TOTAL BIG DISPLAY -->
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="TOTAL:" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding CartState.Total, StringFormat='${0:N2}'}" 
                                   FontSize="{DynamicResource PosPriceFontSize}" FontWeight="ExtraBold" Foreground="{DynamicResource AccentPrimaryBrush}" FontFamily="{DynamicResource AppFontFamily}"/>
                    </Grid>

                    <TextBlock x:Name="CheckoutFeedback" Text="{Binding CheckoutMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="PricingProgress" Text="{Binding CartState.PricingFeedback}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                    <!-- PRIMARY CHECKOUT CTA -->
                    <Button Command="{Binding CheckoutCommand}" CommandParameter="Efectivo" Height="50" Background="{DynamicResource AccentSuccessBrush}" Foreground="White" CornerRadius="{DynamicResource AppCornerRadius}" HorizontalAlignment="Stretch" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <mi:MaterialIcon Kind="LightningBolt" Width="22" Height="22"/>
                            <TextBlock Text="COBRAR TICKET" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>
