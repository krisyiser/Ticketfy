<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Views.Pos.PosProductCatalogView"
             x:DataType="vm:CatalogViewModel">

    <!-- Product Catalog Grid & Categories -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- 1. Search Bar & Fast Multiplier Scanner (N*CODE) + Keybinding Badge [F3] -->
        <Border x:Name="PosSearchBorder" Grid.Row="0" Margin="0,0,0,10" Padding="12,8"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <Border CornerRadius="{DynamicResource AppCornerRadius}" Padding="12,6"
                    Background="{DynamicResource BgTertiaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <mi:MaterialIcon Grid.Column="0" Kind="BarcodeScan" Width="18" Height="18"
                                     Foreground="{DynamicResource AccentPrimaryBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="SearchTextBox" Text="{Binding SearchQuery, Mode=TwoWay}"
                             Watermark="Escanear o buscar (Ej. '6*750123456' para 6 piezas o '0.750*carne')..."
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="13" VerticalAlignment="Center">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ProcessScanOrSearchSubmitCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <!-- Keybinding Indicator Badge [F3] -->
                    <Border Grid.Column="2" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="4" Padding="6,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="..." FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- 2. GPU-Accelerated Category Chips Carousel (with product count badges) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding CategoryChips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryChipDto">
                        <Button Command="{Binding $parent[UserControl].((vm:CatalogViewModel)DataContext).SelectCategoryChipCommand}"
                                CommandParameter="{Binding}"
                                Padding="12,6" CornerRadius="{DynamicResource AppCornerRadius}" Cursor="Hand"
                                Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 3. Main Product Area (WrapPanel Enforcing Top-Left Flow & Predictable 165x190 Cards) -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">
            <ItemsControl ItemsSource="{Binding FilteredProducts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Uniform Grid enforcing exact card width and top-left flow -->
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dto:ProductDto">
                        <Button Command="{Binding $parent[UserControl].((vm:CatalogViewModel)DataContext).AddToCartCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsAvailable}"
                                ToolTip.Tip="{Binding InventoryWarning}"
                                Width="165" Height="190" Margin="6" Padding="0" CornerRadius="{DynamicResource CardCornerRadius}" Cursor="Hand"
                                Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Grid>
                                <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="10">
                                    <!-- Top Header: Category/Icon & Stock Badge -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                        <mi:MaterialIcon Kind="PackageVariant" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Border Grid.Column="1" IsVisible="{DynamicResource ShowStockBadgeResource}" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,3">
                                            <TextBlock Text="{Binding Stock, StringFormat='Stk: {0:0.##}'}" FontSize="10" Foreground="{DynamicResource AccentSuccessBrush}" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Product Title -->
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" MaxLines="2" 
                                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource AppFontFamily}" Margin="0,6,0,0"/>

                                    <!-- SKU Code -->
                                    <TextBlock Grid.Row="2" IsVisible="{DynamicResource ShowBarcodeIconResource}" Text="{Binding Barcode, FallbackValue='SKU: N/A'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" 
                                               FontFamily="{DynamicResource AppFontFamily}" Margin="0,2,0,4"/>

                                    <!-- Monospaced Price Tag -->
                                    <TextBlock Grid.Row="3" Text="{Binding SalePrice, StringFormat='${0:N2}'}" 
                                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" 
                                               FontFamily="{DynamicResource AppFontFamily}"/>
                                </Grid>

                                <!-- OUT OF STOCK OVERLAY -->
                                <Border IsVisible="{Binding IsOutOfStock}" 
                                        Background="#CC1E293B" 
                                        CornerRadius="{DynamicResource CardCornerRadius}" 
                                        HorizontalAlignment="Stretch" 
                                        VerticalAlignment="Stretch">
                                    <Border Background="{DynamicResource AccentDangerBrush}" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Padding="10,5" 
                                            CornerRadius="{DynamicResource AppCornerRadius}">
                                        <TextBlock Text="{Binding UnavailableLabel}"
                                                   Foreground="White" 
                                                   FontWeight="Bold" 
                                                   FontSize="12"/>
                                    </Border>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Spacing="6" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsLoading}">
                <Button Content="Anterior" Command="{Binding PreviousPageCommand}" />
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" />
                <Button Content="Siguiente" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" />
            </StackPanel>
            <TextBlock Text="{Binding FeedbackMessage}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
