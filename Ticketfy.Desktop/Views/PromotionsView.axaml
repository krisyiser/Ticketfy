<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             xmlns:controls="using:Ticketfy.Controls"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Views.PromotionsView"
             x:DataType="vm:PromotionsViewModel">

    <DockPanel LastChildFill="True" Margin="16">
        <Border DockPanel.Dock="Top" Margin="0,0,0,16" Padding="12,8"
                Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <mi:MaterialIcon Kind="TagMultiple" Width="22" Height="22" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    <TextBlock Text="Gestor de Promociones y Ofertas" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding OpenAddPromotionDialogCommand}" Content="NUEVA PROMOCIÓN" Classes="primary-action" Padding="16,8" />
                    <Button x:Name="CreateKitBtn" Command="{Binding OpenCreateItemKitDialogCommand}" Classes="primary-action" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="PackageVariantPlus" Width="18" Height="18" />
                            <TextBlock Text="NUEVO COMBO" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <controls:AlertBannerControl DockPanel.Dock="Top" Message="{Binding FeedbackMessage, Mode=TwoWay}" IsError="{Binding IsFeedbackError}" Margin="0,0,0,12" />

        <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="1">
            <DockPanel LastChildFill="True">

                <DataGrid ItemsSource="{Binding Promotions}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Promoción / Oferta" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Descuento / Valor" Binding="{Binding DiscountValue}" Width="*" />
                        
                        <DataGridTemplateColumn Header="Estado" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:PromotionDto">
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="{Binding IsActive}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Acciones" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:PromotionDto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="Editar" Command="{Binding $parent[DataGrid].((vm:PromotionsViewModel)DataContext).EditPromotionCommand}" CommandParameter="{Binding}" />
                                        <Button Command="{Binding $parent[DataGrid].((vm:PromotionsViewModel)DataContext).ToggleStatusCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4" CornerRadius="4" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                ToolTip.Tip="Activar / Desactivar Promoción">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <mi:MaterialIcon Kind="Power" Width="14" Height="14" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                <TextBlock Text="Cambiar Estado" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding $parent[DataGrid].((vm:PromotionsViewModel)DataContext).DeletePromotionCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="6,4" Background="Transparent" BorderThickness="0"
                                                ToolTip.Tip="Inactivar conservando el historial">
                                            <mi:MaterialIcon Kind="Cancel" Width="16" Height="16" Foreground="{DynamicResource AccentDangerBrush}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
