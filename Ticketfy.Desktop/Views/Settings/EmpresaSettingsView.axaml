<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmsettings="using:Ticketfy.ViewModels.Settings"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:tabs="using:Ticketfy.Views.Settings.Empresa"
             x:Class="Ticketfy.Views.Settings.EmpresaSettingsView"
             x:DataType="vmsettings:EmpresaSettingsViewModel">

    <StackPanel Spacing="20">
        <TextBlock Text="Datos &amp; Configuración de la Empresa" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding FeedbackMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />

        <!-- Horizontal Sub-tab Navigation Bar -->
        <Border Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="4">
            <UniformGrid Columns="5">
                <Button Command="{Binding SelectEmpresaSubTabCommand}" CommandParameter="generales" Padding="10,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="Domain" Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <TextBlock Text="Generales" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding SelectEmpresaSubTabCommand}" CommandParameter="identidad" Padding="10,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="PaletteOutline" Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <TextBlock Text="Identidad" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding SelectEmpresaSubTabCommand}" CommandParameter="fiscal" Padding="10,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="ReceiptTextOutline" Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <TextBlock Text="Fiscal / SAT" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding SelectEmpresaSubTabCommand}" CommandParameter="sucursal" Padding="10,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="MapMarkerOutline" Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <TextBlock Text="Sucursal" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding SelectEmpresaSubTabCommand}" CommandParameter="redes" Padding="10,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="ShareVariantOutline" Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <TextBlock Text="Redes &amp; Web" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>

        <!-- Sub-tabs Container -->
        <tabs:EmpresaGeneralesTab x:Name="BusinessGeneralTab" IsVisible="{Binding IsSubEmpresaGenerales}" />
        <tabs:EmpresaIdentidadTab IsVisible="{Binding IsSubEmpresaIdentidad}" />
        <tabs:EmpresaFiscalTab x:Name="BusinessFiscalTab" IsVisible="{Binding IsSubEmpresaFiscal}" />
        <tabs:EmpresaSucursalTab IsVisible="{Binding IsSubEmpresaSucursal}" />
        <tabs:EmpresaRedesTab IsVisible="{Binding IsSubEmpresaRedes}" />
    </StackPanel>
</UserControl>
