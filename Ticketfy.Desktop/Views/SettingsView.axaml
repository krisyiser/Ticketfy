<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:vmsettings="using:Ticketfy.ViewModels.Settings"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:settings="using:Ticketfy.Views.Settings"
             x:Class="Ticketfy.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid Background="{DynamicResource BgPrimaryBrush}" Margin="16">
        <!-- Main Container Card -->
        <Border Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}"
                ClipToBounds="True">
            <DockPanel LastChildFill="True">

                <!-- ═══ 1. TOP TITLE BAR ═══ -->
                <Border DockPanel.Dock="Top" Height="56"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="1" Content="Actualizar sección" Command="{Binding RefreshSectionCommand}" IsEnabled="{Binding !IsSectionLoading}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="CogOutline" Width="22" Height="22" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBlock Text="Motor Unificado de Configuración &amp; Personalización" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ 2. BOTTOM ACTION FOOTER ═══ -->
                <Border DockPanel.Dock="Bottom" Height="64"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,12">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{Binding FeedbackMessage}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                        <Button Grid.Column="1" Command="{Binding CloseCommand}" Content="Volver al POS" Padding="20,10" Margin="0,0,12,0"
                                Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" CornerRadius="{DynamicResource AppCornerRadius}" Cursor="Hand" />

                        <Button Grid.Column="2" Command="{Binding SaveAllSettingsCommand}" IsEnabled="{Binding CanEditSection}" Padding="20,10" Classes="primary-action" FontSize="13" FontWeight="Bold" CornerRadius="{DynamicResource AppCornerRadius}" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="ContentSave" Width="18" Height="18" />
                                <TextBlock Text="GUARDAR CONFIGURACIÓN" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ═══ 3. MAIN BODY (ATOMIC NAVIGATION & ZERO Z-INDEX LEAK) ═══ -->
                <Grid ColumnDefinitions="250,*">

                    <!-- ─── LEFT SIDEBAR NAVIGATION ─── -->
                    <Border Grid.Column="0" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Padding="16,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding CurrentAppVersion, StringFormat='TICKETFY! {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Valcore Engine 4.0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6" Margin="8">
                                    <TextBlock Text="EJES DE CONFIGURACIÓN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,8,8,4" />

                                    <ItemsControl ItemsSource="{Binding Sections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vmsettings:SettingsSectionItem">
                                                <Button Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectSectionCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="12,11" Margin="0,2" CornerRadius="{DynamicResource AppCornerRadius}" HorizontalAlignment="Stretch" Cursor="Hand"
                                                        Background="{DynamicResource BgTertiaryBrush}">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <mi:MaterialIcon Kind="{Binding IconKind}" Width="20" Height="20" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- ─── ATOMIC VIEW HOST (TRANSITIONING CONTENT CONTROL - ZERO OVERLAP GUARANTEE) ─── -->
                    <Grid Grid.Column="1" Margin="20">
                        <TextBlock Text="Cargando configuración..." IsVisible="{Binding IsSectionLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TransitioningContentControl x:Name="SettingsSectionHost" Content="{Binding CurrentSectionViewModel}" IsEnabled="{Binding CanEditSection}" IsVisible="{Binding CanEditSection}">
                            <TransitioningContentControl.PageTransition>
                                <CrossFade Duration="0:0:0.200" />
                            </TransitioningContentControl.PageTransition>

                            <TransitioningContentControl.DataTemplates>
                                <DataTemplate DataType="{x:Type vmsettings:PersonalizacionSettingsViewModel}">
                                    <settings:PersonalizacionSettingsView />
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vmsettings:EmpresaSettingsViewModel}">
                                    <settings:EmpresaSettingsView />
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vmsettings:HardwareSettingsViewModel}">
                                    <settings:HardwareSettingsView />
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vmsettings:SeguridadSettingsViewModel}">
                                    <settings:SeguridadSettingsView />
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vmsettings:UsuariosSettingsViewModel}">
                                    <settings:UsuariosSettingsView />
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vmsettings:AcercaDeSettingsViewModel}">
                                    <settings:AcercaDeSettingsView />
                                </DataTemplate>
                            </TransitioningContentControl.DataTemplates>
                        </TransitioningContentControl>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
