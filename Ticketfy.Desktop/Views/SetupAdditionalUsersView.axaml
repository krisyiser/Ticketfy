<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Ticketfy.Controls"
             xmlns:sys="using:System"
             x:Class="Ticketfy.Views.SetupAdditionalUsersView"
             x:DataType="vm:SetupAdditionalUsersViewModel">

    <Grid Background="{DynamicResource BgPrimaryBrush}">
        <Border Width="450" Padding="32" CornerRadius="12"
                Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="20">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <Border Width="56" Height="56" CornerRadius="8" Background="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="AccountMultiplePlus" Width="32" Height="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Usuarios Adicionales" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Cree cuentas para su personal (Opcional)" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">
                    <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource BgTertiaryBrush}" Padding="12" />
                    <TextBox Text="{Binding FullName, Mode=TwoWay}" MaxLength="256" Watermark="Nombre Completo *" Background="{DynamicResource BgTertiaryBrush}" Padding="12" />
                    <TextBox Text="{Binding Username, Mode=TwoWay}" MaxLength="128" Watermark="Nombre de Usuario *" Background="{DynamicResource BgTertiaryBrush}" Padding="12" />
                    <TextBox Text="{Binding Password, Mode=TwoWay}" MaxLength="1024" PasswordChar="•" Watermark="Contraseña *" Background="{DynamicResource BgTertiaryBrush}" Padding="12" />
                    <TextBlock Text="{Binding PasswordHelp}" TextWrapping="Wrap" FontSize="12" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="PIN rápido de 4 Dígitos *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <controls:PinInputControl Pin1="{Binding Pin1, Mode=TwoWay}" Pin2="{Binding Pin2, Mode=TwoWay}" Pin3="{Binding Pin3, Mode=TwoWay}" Pin4="{Binding Pin4, Mode=TwoWay}" HorizontalAlignment="Left" />
                    </StackPanel>
                    
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AccentDangerBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource AccentSuccessBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <Button Command="{Binding CreateUserCommand}" Classes="primary-action" Height="44" HorizontalAlignment="Stretch">
                        <TextBlock Text="AGREGAR USUARIO ADICIONAL" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Grid ColumnDefinitions="*,12,*">
                        <Button Grid.Column="0" Command="{Binding GoBackCommand}" Background="{DynamicResource BgTertiaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Height="44" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                                <TextBlock Text="VOLVER" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding SkipCommand}" Background="{DynamicResource AccentPrimaryBrush}" Height="44" HorizontalAlignment="Stretch">
                            <TextBlock Text="FINALIZAR CONFIGURACIÓN" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
