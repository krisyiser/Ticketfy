<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels.Suppliers"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Views.Suppliers.PurchaseHistoryView"
             x:DataType="vm:PurchaseHistoryViewModel">
    
    <Grid>
        <Border x:Name="PurchaseHistoryContainer" Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                    <TextBlock Text="Historial de Remisiones y Órdenes de Compra" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Historial paginado de entradas de mercancía y reabastecimientos." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsLoading}">
                        <TextBox Text="{Binding Search}" Watermark="Proveedor, factura o documento" Width="280" />
                        <Button Content="Buscar" Command="{Binding SearchPurchasesCommand}" />
                        <Button Content="Anterior" Command="{Binding PreviousPageCommand}" />
                        <Button Content="Siguiente" Command="{Binding NextPageCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding FeedbackMessage}" FontSize="12" Foreground="{DynamicResource AccentSuccessBrush}" />
                    <TextBlock Text="Consultando detalle…" IsVisible="{Binding IsLoadingDetail}" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Purchases}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. Remisión / Factura" Binding="{Binding InvoiceNumber}" Width="1.5*" />
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding SupplierName}" Width="2*" />
                        <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding Date}" Width="1.5*" />
                        <DataGridTextColumn Header="Total registrado" Binding="{Binding TotalCost, StringFormat='${0:N2}'}" Width="1*" />
                        <DataGridTextColumn Header="Pagos documentados" Binding="{Binding RecordedPaymentsDisplay}" Width="1*" />
                        <DataGridTextColumn Header="Saldo (+ deuda / - crédito)" Binding="{Binding BalanceDisplay}" Width="1*" />
                        <DataGridTextColumn Header="Estado financiero" Binding="{Binding FinancialStatus}" Width="2*" />
                        <DataGridTextColumn Header="Estado del desglose" Binding="{Binding DetailStatus}" Width="2*" />
                        <DataGridTemplateColumn Header="Acciones" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:PurchaseDto">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Command="{Binding $parent[DataGrid].((vm:PurchaseHistoryViewModel)DataContext).ViewPurchaseDetailCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4" CornerRadius="4"
                                                ToolTip.Tip="Ver desglose detallado de artículos de esta compra"
                                                Background="{DynamicResource BgTertiaryBrush}"
                                                BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <mi:MaterialIcon Kind="Eye" Width="13" Height="13" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                <TextBlock Text="Ver Detalle" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding $parent[DataGrid].((vm:PurchaseHistoryViewModel)DataContext).PrintPurchaseTicketCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4" CornerRadius="4"
                                                ToolTip.Tip="Imprimir ticket de esta compra"
                                                Background="{DynamicResource BgTertiaryBrush}"
                                                BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <mi:MaterialIcon Kind="Printer" Width="13" Height="13" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                <TextBlock Text="Imprimir" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ═══ DETALLE DE COMPRA MODAL DIALOG ═══ -->
        <Border Background="#80000000" IsVisible="{Binding IsPurchaseDetailDialogOpen}" Padding="20">
            <Border Width="850" MaxHeight="850" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20"
                    Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                <DockPanel LastChildFill="True" DataContext="{Binding SelectedPurchaseForDetail}">
                    <!-- Title Bar -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="ReceiptText" Width="22" Height="22" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                <TextBlock Text="Detalle de Remisión de Compra" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding $parent[UserControl].((vm:PurchaseHistoryViewModel)DataContext).ClosePurchaseDetailCommand}" Background="Transparent" BorderThickness="0" Padding="4">
                                <mi:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextMutedBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Bottom Close Button -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Command="{Binding $parent[UserControl].((vm:PurchaseHistoryViewModel)DataContext).PrintPurchaseTicketCommand}"
                                CommandParameter="{Binding}" Padding="14,8" CornerRadius="6"
                                Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="Printer" Width="15" Height="15" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                <TextBlock Text="IMPRIMIR TICKET" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding $parent[UserControl].((vm:PurchaseHistoryViewModel)DataContext).ClosePurchaseDetailCommand}"
                                Content="CERRAR" Padding="16,8" CornerRadius="6" Classes="primary-action" FontWeight="Bold" />
                    </StackPanel>

                    <!-- Info & Items List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding DetailWarning}" IsVisible="{Binding !DetailsAvailable}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentWarningBrush}" />
                            <!-- Metadata Header Banner -->
                            <Border Background="{DynamicResource BgPrimaryBrush}" Padding="12" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="No. Remisión / Factura:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding InvoiceNumber}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Proveedor:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SupplierName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Spacing="2">
                                        <TextBlock Text="Fecha y Hora:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Date}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Spacing="2">
                                        <TextBlock Text="Total registrado:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding TotalCost, StringFormat='${0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Items DataGrid -->
                            <TextBlock Text="{Binding FinancialStatus}" TextWrapping="Wrap" FontWeight="Bold" />
                            <TextBlock Text="{Binding RecordedPaymentsDisplay, StringFormat='Pagos documentados: {0}'}" />
                            <TextBlock Text="{Binding BalanceDisplay, StringFormat='Saldo del documento (+ deuda / - crédito): {0}'}" />
                            <Border IsVisible="{Binding Financial, Converter={x:Static ObjectConverters.IsNotNull}}">
                             <StackPanel DataContext="{Binding Financial}" Spacing="3">
                                <TextBlock Text="{Binding Returns, StringFormat='Devoluciones de mercancía: {0:C2}'}" />
                                <TextBlock Text="{Binding CreditApplied, StringFormat='Crédito aplicado: {0:C2}'}" />
                                <TextBlock Text="{Binding CreditTransferred, StringFormat='Crédito trasladado a otra compra: {0:C2}'}" />
                                <TextBlock Text="{Binding CreditRefunded, StringFormat='Reembolsos recibidos: {0:C2}'}" />
                                <TextBlock Text="{Binding AvailableCredit, StringFormat='Saldo a favor disponible (sin reservas): {0:C2}'}" />
                             </StackPanel>
                            </Border>
                            <TextBlock Text="Artículos e Insumos Ingresados:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

                            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Descripción Artículo" Binding="{Binding ProductName}" Width="2*" />
                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat='{}{0:N3}'}" Width="1*" />
                                    <DataGridTextColumn Header="Devuelto" Binding="{Binding ReturnedQuantity, StringFormat='{}{0:N3}'}" Width="1*" />
                                    <DataGridTextColumn Header="Disponible para devolver" Binding="{Binding ReturnableQuantity, StringFormat='{}{0:N3}'}" Width="1*" />
                                    <DataGridTextColumn Header="Costo Unit." Binding="{Binding UnitPrice, StringFormat='${0:N2}'}" Width="1*" />
                                    <DataGridTextColumn Header="Importe Total" Binding="{Binding TotalPrice, StringFormat='${0:N2}'}" Width="1*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel DataContext="{Binding $parent[UserControl].((vm:PurchaseHistoryViewModel)DataContext)}" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding !IsLoadingFinancial}">
                                    <Button Content="Consultar movimientos" Command="{Binding LoadFinancialCommand}" />
                                    <Button Content="Movimientos anteriores" Command="{Binding PreviousFinancialCommand}" IsEnabled="{Binding HasPreviousFinancial}" />
                                    <Button Content="Movimientos siguientes" Command="{Binding NextFinancialCommand}" IsEnabled="{Binding HasMoreFinancial}" />
                                </StackPanel>
                                <TextBlock Text="{Binding FinancialFeedback}" TextWrapping="Wrap" />
                                <DataGrid ItemsSource="{Binding FinancialEntries}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="250">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding DateDisplay}" />
                                        <DataGridTextColumn Header="Movimiento" Binding="{Binding TypeDisplay}" />
                                        <DataGridTextColumn Header="Importe al saldo" Binding="{Binding Amount, StringFormat='{}{0:C2}'}" />
                                        <DataGridTextColumn Header="Medio" Binding="{Binding Method}" />
                                        <DataGridTextColumn Header="Referencia" Binding="{Binding Reference}" />
                                        <DataGridTextColumn Header="Operación" Binding="{Binding OperationId}" />
                                        <DataGridTextColumn Header="Operador (ID)" Binding="{Binding CashierUserId}" />
                                        <DataGridTextColumn Header="Caja" Binding="{Binding RegisterId}" />
                                        <DataGridTextColumn Header="Turno" Binding="{Binding ShiftId}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
