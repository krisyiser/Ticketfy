<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels.Suppliers"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Ticketfy.Controls"
             x:Class="Ticketfy.Views.Suppliers.PurchaseOrderView"
             x:DataType="vm:PurchaseOrderViewModel">

    <!-- Right Panel: Register Purchase Order (Entrada de Mercancía) -->
    <Border x:Name="PurchaseOrderForm" Padding="16"
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
        <Grid RowDefinitions="Auto,*,Auto">
            <controls:AlertBannerControl Grid.Row="0" Message="{Binding FeedbackMessage, Mode=TwoWay}" IsError="{Binding IsFeedbackError}" Margin="0,0,0,10" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Spacing="10" IsEnabled="{Binding !IsSubmitting}">
                <TextBlock Text="Nueva Orden de Compra (Reabastecimiento)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                        <TextBlock Text="Proveedor" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid IsVisible="{Binding NeedsSupplierSearch}" ColumnDefinitions="*,Auto">
                            <TextBox Text="{Binding SupplierSearch}" Watermark="Buscar proveedor" />
                            <Button Grid.Column="1" Content="Buscar" Command="{Binding SearchSuppliersCommand}" />
                        </Grid>
                        <ComboBox PlaceholderText="Seleccione Proveedor..." ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:SupplierDto">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="4">
                        <TextBlock Text="No. Factura / Remisión" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding InvoiceNumber, Mode=TwoWay}" Watermark="Ej. FAC-9904" Padding="10,8" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />

                <!-- Add Item Row -->
                <Grid IsVisible="{Binding NeedsProductSearch}" ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding ProductSearch}" Watermark="Buscar producto por nombre o código" />
                    <Button Grid.Column="1" Content="Buscar" Command="{Binding SearchProductsCommand}" />
                </Grid>
                <CheckBox Foreground="{DynamicResource TextPrimaryBrush}" Content="Sólo productos con este proveedor preferido" IsChecked="{Binding PreferredSupplierOnly}" />
                <TextBlock Text="{Binding CatalogMessage}" FontSize="11" TextWrapping="Wrap" />
                <Grid x:Name="AddPurchaseItemRow" ColumnDefinitions="2.5*, 1*, 1*, Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="4">
                        <TextBlock Text="Producto" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox PlaceholderText="Seleccione Producto..." ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:ProductDto">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="2,0" Spacing="4">
                        <TextBlock Text="Costo Unid." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding PurchaseUnitPrice, Mode=TwoWay}" Watermark="$ Costo" Padding="8" Background="{DynamicResource BgTertiaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="2,0" Spacing="4">
                        <TextBlock Text="Cantidad" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding PurchaseQuantity, Mode=TwoWay}" Watermark="Cant." Padding="8" />
                    </StackPanel>

                    <Button ToolTip.Tip="Agregar producto a la compra" Grid.Column="3" Command="{Binding AddItemToPurchaseDraftCommand}" Padding="10,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource AccentSuccessBrush}" Foreground="White" Margin="4,0,0,0" VerticalAlignment="Bottom">
                        <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
                    </Button>
                </Grid>

            <!-- Purchase Draft Items Table -->

                <ItemsControl ItemsSource="{Binding DraftPurchaseItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:PurchaseItemDto">
                            <Border Margin="0,0,0,4" Padding="10,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0} Pza'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='${0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                    <Button Grid.Column="3" Command="{Binding $parent[UserControl].((vm:PurchaseOrderViewModel)DataContext).RemoveItemFromPurchaseDraftCommand}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="2">
                                        <mi:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource AccentDangerBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <TextBlock Text="Forma de pago" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding PurchasePaymentMethods}" SelectedItem="{Binding PurchasePaymentMethod}" HorizontalAlignment="Stretch" />
                <TextBlock IsVisible="{Binding !IsCreditPurchase}" Text="Importe pagado ahora (resto a cuenta por pagar)" />
                <NumericUpDown IsVisible="{Binding !IsCreditPurchase}" Value="{Binding PurchasePaidAmount, Mode=TwoWay}" Minimum="0" FormatString="0.00" />
                <TextBox IsVisible="{Binding NeedsPaymentReference}" Text="{Binding PurchasePaymentReference}" Watermark="Referencia bancaria / comprobante" />
                <TextBox Text="{Binding PurchaseDueDate}" Watermark="Vencimiento AAAA-MM-DD (crédito)" />
            </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="COSTO TOTAL COMPRA:" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding TotalPurchaseCost, StringFormat='${0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                </Grid>
                <Button x:Name="ConfirmPurchaseBtn" Command="{Binding ConfirmPurchaseCommand}" Content="{Binding SubmitButtonText}" Padding="16,12" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource AccentSuccessBrush}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

